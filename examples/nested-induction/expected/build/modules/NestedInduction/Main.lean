public import LexLeanRuntime.Laws
set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000000
set_option linter.constructorNameAsVariable false
namespace NestedInduction.Main

public inductive Json where
  | null
  | text (_ : String)
  | array (_ : List (Json))
  | object (_ : List ((Prod (String) (Json))))

mutual
@[expose] public def size : (value : Json) -> Nat
  | Json.null => 1
  | Json.text _ => 1
  | Json.array items => (1 + sizeList (items))
  | Json.object entries => (1 + sizeEntries (entries))
termination_by structural value => value

@[expose] public def sizeList : (items : List (Json)) -> Nat
  | List.nil => 0
  | List.cons head tail => (size (head) + sizeList (tail))
termination_by structural items => items

@[expose] public def sizeEntries : (entries : List ((Prod (String) (Json)))) -> Nat
  | List.nil => 0
  | List.cons head tail => (sizeEntry (head) + sizeEntries (tail))
termination_by structural entries => entries

@[expose] public def sizeEntry : (entry : (Prod (String) (Json))) -> Nat
  | Prod.mk _ value => size (value)
termination_by structural entry => entry
end

mutual
@[expose] public def leaves : (value : Json) -> Nat
  | Json.null => 1
  | Json.text _ => 1
  | Json.array items => leavesList (items)
  | Json.object entries => leavesEntries (entries)
termination_by structural value => value

@[expose] public def leavesList : (items : List (Json)) -> Nat
  | List.nil => 0
  | List.cons head tail => (leaves (head) + leavesList (tail))
termination_by structural items => items

@[expose] public def leavesEntries : (entries : List ((Prod (String) (Json)))) -> Nat
  | List.nil => 0
  | List.cons head tail => (leavesEntry (head) + leavesEntries (tail))
termination_by structural entries => entries

@[expose] public def leavesEntry : (entry : (Prod (String) (Json))) -> Nat
  | Prod.mk _ value => leaves (value)
termination_by structural entry => entry
end

