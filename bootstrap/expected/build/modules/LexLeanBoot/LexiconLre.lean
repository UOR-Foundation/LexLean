@[expose] public def nothingStep (fuel : Nat) (state : (Prod (List (Render)) (Nat))) : Option ((Prod (List (Render)) (Nat))) := (if (Nat.beq ((state).2) (1)) then Option.none else (match (state).1 with | List.nil => Option.none | List.cons top rest => (match top with | Render.RSpace => Option.some ((rest, 0)) | Render.RSeq items => Option.some (((LexLeanCollections.listFold ((fun (acc : List (Render)) (item : Render) => (item :: acc))) (rest) (renderItems (items) (fuel)) : List (Render)), 0)) | Render.RForm _ _ _ => Option.some ((rest, 1)) | Render.RSelfForm _ => Option.some ((rest, 1)) | Render.RSlot _ => Option.some ((rest, 1)) | Render.RToken _ => Option.some ((rest, 1)) | Render.RGroup _ => Option.some ((rest, 1)) | Render.RParen _ => Option.some ((rest, 1)) | Render.RBracket _ => Option.some ((rest, 1)) | Render.RSub _ _ => Option.some ((rest, 1)) | Render.RSup _ _ => Option.some ((rest, 1)) | Render.RFrac _ _ => Option.some ((rest, 1)) | Render.ROperatorName _ => Option.some ((rest, 1)) | Render.RNil => Option.some ((rest, 1)) | Render.RItem _ _ => Option.some ((rest, 1)))))

