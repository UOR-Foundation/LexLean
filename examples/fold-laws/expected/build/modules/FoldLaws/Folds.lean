@[expose] public def credit (opening : Int) (movements : List (Int)) : Int := (LexLeanCollections.listFold ((fun (acc : Int) (v : Int) => (LexLeanRuntime.subtract (acc) ((LexLeanRuntime.negate (v) : Int)) : Int))) (opening) (movements) : Int)

