  | LexLeanBoot.RustValidate.Ty.TyFixed kind, state => push (state) (31) (intCode (kind))
  | LexLeanBoot.RustValidate.Ty.TyUnary kind inner, state => flatTy (inner) (push (state) (32) (unaryCode (kind)))
