  | LexLeanBoot.RustValidate.Ty.TyNil, state => push (state) (36) (0)
  | LexLeanBoot.RustValidate.Ty.TyCons head tail, state => flatTy (tail) (flatTy (head) (push (state) (37) (0)))

@[expose] public def flatLit (lit : LexLeanBoot.RustAst.Lit) (state : Flat) : Flat := (match lit with | LexLeanBoot.RustAst.Lit.LitUnit => push (state) (0) (0) | LexLeanBoot.RustAst.Lit.LitBool flag => push (state) (1) ((if flag then 1 else 0)) | LexLeanBoot.RustAst.Lit.LitNat number => push (state) (2) (number) | LexLeanBoot.RustAst.Lit.LitInt negative magnitude => push (push (state) (3) ((if negative then 1 else 0))) (4) (magnitude) | LexLeanBoot.RustAst.Lit.LitFixed kind negative magnitude => push (push (push (state) (5) (intCode (kind))) (3) ((if negative then 1 else 0))) (4) (magnitude) | LexLeanBoot.RustAst.Lit.LitStr text => pushBlob (state) (6) (text) | LexLeanBoot.RustAst.Lit.LitBytes octets => pushBlob (state) (7) (octets) | LexLeanBoot.RustAst.Lit.LitOrdering kind => push (state) (8) (ordCode (kind)) | LexLeanBoot.RustAst.Lit.LitOverflow => push (state) (9) (0))

@[expose] public def flatCon (con : LexLeanBoot.RustValidate.Con) (state : Flat) : Flat := (match con with | LexLeanBoot.RustValidate.Con.ConNone ty => flatTy (ty) (push (state) (40) (0)) | LexLeanBoot.RustValidate.Con.ConSome => push (state) (41) (0) | LexLeanBoot.RustValidate.Con.ConOk ok error => flatTy (error) (flatTy (ok) (push (state) (42) (0))) | LexLeanBoot.RustValidate.Con.ConErr ok error => flatTy (error) (flatTy (ok) (push (state) (43) (0))) | LexLeanBoot.RustValidate.Con.ConAdt adt constructor => push (push (state) (44) (adt)) (45) (constructor) | LexLeanBoot.RustValidate.Con.ConClosure fnType function => push (push (state) (46) (fnType)) (47) (function) | LexLeanBoot.RustValidate.Con.ConCons => push (state) (48) (0) | LexLeanBoot.RustValidate.Con.ConNil ty => flatTy (ty) (push (state) (49) (0)))

@[expose] public def flatCallee (callee : LexLeanBoot.RustAst.Callee) (state : Flat) : Flat := (match callee with | LexLeanBoot.RustAst.Callee.CalFn number => push (state) (50) (number) | LexLeanBoot.RustAst.Callee.CalRt rt => push (push (state) (51) ((rt).family)) (52) (widthCode ((rt).width)) | LexLeanBoot.RustAst.Callee.CalMachine family width => push (push (state) (53) (family)) (54) (widthCode (width)))

