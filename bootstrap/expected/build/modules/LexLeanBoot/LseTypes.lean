public structure Ck where
  metas : List ((Prod (ByteArray) (LexLeanBoot.LexiconLse.Lse)))
  nextMeta : Nat
  literals : List (ByteArray)
  freshCounter : Nat
  exhausted : Bool
  rows : List (CRow)
  fallback : Nat

public structure Bd where
  mode : Nat
  name : ByteArray
