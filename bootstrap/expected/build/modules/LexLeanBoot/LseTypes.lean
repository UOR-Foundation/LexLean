@[expose] public def lit (literal : String) : ByteArray := (LexLeanRuntime.utf8Encode (literal) : ByteArray)

@[expose] public def cat (left : ByteArray) (right : ByteArray) : ByteArray := (LexLeanRuntime.append (left) (right) : ByteArray)

@[expose] public def shown (expr : LexLeanBoot.LexiconLse.Lse) : ByteArray := cat (cat (lit ("`")) (LexLeanBoot.LexiconLse.printLse (expr) (false))) (lit ("`"))

@[expose] public def mkFuel (depth : Nat) : Fuel := ((LexLeanCollections.iterateUntil ((fun (rest : Fuel) => Option.some (Fuel.FS (rest)))) (depth) (Fuel.FZ) : (Prod (Fuel) (Bool)))).1

@[expose] public def isMeta (name : ByteArray) : Bool := (Nat.beq (LexLeanBoot.LexiconLse.byteNum (name) (0)) (63))

@[expose] public def metaOf (expr : LexLeanBoot.LexiconLse.Lse) : Option (ByteArray) := (match expr with | LexLeanBoot.LexiconLse.Lse.LLocal name => (if isMeta (name) then Option.some (name) else Option.none) | LexLeanBoot.LexiconLse.Lse.LSortProp => Option.none | LexLeanBoot.LexiconLse.Lse.LSortType _ => Option.none | LexLeanBoot.LexiconLse.Lse.LConst _ _ _ => Option.none | LexLeanBoot.LexiconLse.Lse.LApp _ _ => Option.none | LexLeanBoot.LexiconLse.Lse.LPi _ _ => Option.none | LexLeanBoot.LexiconLse.Lse.LLam _ _ => Option.none | LexLeanBoot.LexiconLse.Lse.LLet _ _ _ _ => Option.none | LexLeanBoot.LexiconLse.Lse.LNat _ => Option.none | LexLeanBoot.LexiconLse.Lse.LNil => Option.none | LexLeanBoot.LexiconLse.Lse.LArg _ _ => Option.none | LexLeanBoot.LexiconLse.Lse.LBinder _ _ _ _ => Option.none)

@[expose] public def kindOf (expr : LexLeanBoot.LexiconLse.Lse) : Nat := (match expr with | LexLeanBoot.LexiconLse.Lse.LSortProp => 0 | LexLeanBoot.LexiconLse.Lse.LSortType _ => 1 | LexLeanBoot.LexiconLse.Lse.LConst _ _ _ => 2 | LexLeanBoot.LexiconLse.Lse.LLocal _ => 3 | LexLeanBoot.LexiconLse.Lse.LApp _ _ => 4 | LexLeanBoot.LexiconLse.Lse.LPi _ _ => 5 | LexLeanBoot.LexiconLse.Lse.LLam _ _ => 6 | LexLeanBoot.LexiconLse.Lse.LLet _ _ _ _ => 7 | LexLeanBoot.LexiconLse.Lse.LNat _ => 8 | LexLeanBoot.LexiconLse.Lse.LNil => 9 | LexLeanBoot.LexiconLse.Lse.LArg _ _ => 9 | LexLeanBoot.LexiconLse.Lse.LBinder _ _ _ _ => 9)

@[expose] public def atomKey (expr : LexLeanBoot.LexiconLse.Lse) : ByteArray := (match expr with | LexLeanBoot.LexiconLse.Lse.LConst p e _ => cat (cat (p) (lit ("::"))) (e) | LexLeanBoot.LexiconLse.Lse.LLocal name => name | LexLeanBoot.LexiconLse.Lse.LNat digits => digits | LexLeanBoot.LexiconLse.Lse.LSortProp => _root_.ByteArray.mk #[] | LexLeanBoot.LexiconLse.Lse.LSortType _ => _root_.ByteArray.mk #[] | LexLeanBoot.LexiconLse.Lse.LApp _ _ => _root_.ByteArray.mk #[] | LexLeanBoot.LexiconLse.Lse.LPi _ _ => _root_.ByteArray.mk #[] | LexLeanBoot.LexiconLse.Lse.LLam _ _ => _root_.ByteArray.mk #[] | LexLeanBoot.LexiconLse.Lse.LLet _ _ _ _ => _root_.ByteArray.mk #[] | LexLeanBoot.LexiconLse.Lse.LNil => _root_.ByteArray.mk #[] | LexLeanBoot.LexiconLse.Lse.LArg _ _ => _root_.ByteArray.mk #[] | LexLeanBoot.LexiconLse.Lse.LBinder _ _ _ _ => _root_.ByteArray.mk #[])

@[expose] public def ckWith (st : Ck) (metas : List ((Prod (ByteArray) (LexLeanBoot.LexiconLse.Lse)))) (nextMeta : Nat) (literals : List (ByteArray)) (freshCounter : Nat) (exhausted : Bool) : Ck := ({ metas := metas, nextMeta := nextMeta, literals := literals, freshCounter := freshCounter, exhausted := exhausted, rows := (st).rows, fallback := (st).fallback } : Ck)

@[expose] public def ckExhaust (st : Ck) : Ck := ckWith (st) ((st).metas) ((st).nextMeta) ((st).literals) ((st).freshCounter) (true)

@[expose] public def ckSolve (st : Ck) (name : ByteArray) (solution : LexLeanBoot.LexiconLse.Lse) : Ck := ckWith (st) (((name, solution) :: (st).metas)) ((st).nextMeta) ((st).literals) ((st).freshCounter) ((st).exhausted)

@[expose] public def freshMeta (st : Ck) : Sr := ({ out := LexLeanBoot.LexiconLse.Lse.LLocal (cat (lit ("?")) (LexLeanStd.Numeral.decimal ((st).nextMeta))), ck := ckWith (st) ((st).metas) (((st).nextMeta + 1)) ((st).literals) ((st).freshCounter) ((st).exhausted) } : Sr)

@[expose] public def literalMeta (st : Ck) : Sr := (let made : Sr := freshMeta (st); (let after : Ck := (made).ck; ({ out := (made).out, ck := ckWith (after) ((after).metas) ((after).nextMeta) ((cat (lit ("?")) (LexLeanStd.Numeral.decimal ((st).nextMeta)) :: (after).literals)) ((after).freshCounter) ((after).exhausted) } : Sr)))

@[expose] public def freshLocal (st : Ck) (base : ByteArray) : (Prod (ByteArray) (Ck)) := (let counter : Nat := ((st).freshCounter + 1); (cat (cat (base) (_root_.ByteArray.mk #[(_root_.UInt8.ofNat (nat_lit 35))])) (LexLeanStd.Numeral.decimal (counter)), ckWith (st) ((st).metas) ((st).nextMeta) ((st).literals) (counter) ((st).exhausted)))

@[expose] public def solvedOf (metas : List ((Prod (ByteArray) (LexLeanBoot.LexiconLse.Lse)))) (name : ByteArray) : Option (LexLeanBoot.LexiconLse.Lse) := (LexLeanCollections.listFold ((fun (found : Option (LexLeanBoot.LexiconLse.Lse)) (row : (Prod (ByteArray) (LexLeanBoot.LexiconLse.Lse))) => (match found with | Option.some _ => found | Option.none => (if (LexLeanRuntime.equal ((row).1) (name) : Bool) then Option.some ((row).2) else Option.none)))) (Option.none) (metas) : Option (LexLeanBoot.LexiconLse.Lse))

@[expose] public def lookupRow (st : Ck) (package : ByteArray) (entry : ByteArray) : (Prod (Nat) (Bool)) := (match (LexLeanCollections.listFold ((fun (found : Option (CRow)) (row : CRow) => (match found with | Option.some _ => found | Option.none => (if (if (LexLeanRuntime.equal ((row).package) (package) : Bool) then (LexLeanRuntime.equal ((row).entry) (entry) : Bool) else false) then Option.some (row) else Option.none)))) (Option.none) ((st).rows) : Option (CRow)) with | Option.some row => ((row).kind, (row).defined) | Option.none => ((st).fallback, false))

@[expose] public def signatureOf (st : Ck) (package : ByteArray) (entry : ByteArray) : LexLeanBoot.LexiconLse.Lse := (match (LexLeanCollections.listFold ((fun (found : Option (CRow)) (row : CRow) => (match found with | Option.some _ => found | Option.none => (if (if (LexLeanRuntime.equal ((row).package) (package) : Bool) then (LexLeanRuntime.equal ((row).entry) (entry) : Bool) else false) then Option.some (row) else Option.none)))) (Option.none) ((st).rows) : Option (CRow)) with | Option.some row => (row).signature | Option.none => LexLeanBoot.LexiconLse.Lse.LSortProp)

@[expose] public def unfoldsConst (st : Ck) (package : ByteArray) (entry : ByteArray) : Bool := (let found : (Prod (Nat) (Bool)) := lookupRow (st) (package) (entry); (if (Nat.beq ((found).1) (1)) then true else (if (Nat.beq ((found).1) (3)) then (found).2 else false)))

@[expose] public def mayUnfold : (fuel : Fuel) -> (st : Ck) -> (expr : LexLeanBoot.LexiconLse.Lse) -> Bool
  | Fuel.FZ, _st, _expr => false
  | Fuel.FS f, st, expr => (match expr with | LexLeanBoot.LexiconLse.Lse.LConst p e _ => unfoldsConst (st) (p) (e) | LexLeanBoot.LexiconLse.Lse.LApp g _ => mayUnfold (f) (st) (g) | LexLeanBoot.LexiconLse.Lse.LSortProp => false | LexLeanBoot.LexiconLse.Lse.LSortType _ => false | LexLeanBoot.LexiconLse.Lse.LLocal _ => false | LexLeanBoot.LexiconLse.Lse.LPi _ _ => false | LexLeanBoot.LexiconLse.Lse.LLam _ _ => false | LexLeanBoot.LexiconLse.Lse.LLet _ _ _ _ => false | LexLeanBoot.LexiconLse.Lse.LNat _ => false | LexLeanBoot.LexiconLse.Lse.LNil => false | LexLeanBoot.LexiconLse.Lse.LArg _ _ => false | LexLeanBoot.LexiconLse.Lse.LBinder _ _ _ _ => false)

@[expose] public def both (left : Option (LexLeanBoot.LexiconLse.Lse)) (right : Option (LexLeanBoot.LexiconLse.Lse)) : Option ((Prod (LexLeanBoot.LexiconLse.Lse) (LexLeanBoot.LexiconLse.Lse))) := (match left with | Option.none => Option.none | Option.some l => (match right with | Option.none => Option.none | Option.some r => Option.some ((l, r))))

@[expose] public def zonk : (fuel : Fuel) -> (metas : List ((Prod (ByteArray) (LexLeanBoot.LexiconLse.Lse)))) -> (expr : LexLeanBoot.LexiconLse.Lse) -> Option (LexLeanBoot.LexiconLse.Lse)
  | Fuel.FZ, _metas, _expr => Option.none
  | Fuel.FS f, metas, expr => (match expr with | LexLeanBoot.LexiconLse.Lse.LLocal name => (if isMeta (name) then (match solvedOf (metas) (name) with | Option.some solution => zonk (f) (metas) (solution) | Option.none => Option.some (LexLeanBoot.LexiconLse.Lse.LLocal (name))) else Option.some (LexLeanBoot.LexiconLse.Lse.LLocal (name))) | LexLeanBoot.LexiconLse.Lse.LApp g args => (match both (zonk (f) (metas) (g)) (zonk (f) (metas) (args)) with | Option.some zs => Option.some (LexLeanBoot.LexiconLse.Lse.LApp ((zs).1) ((zs).2)) | Option.none => Option.none) | LexLeanBoot.LexiconLse.Lse.LArg h t => (match both (zonk (f) (metas) (h)) (zonk (f) (metas) (t)) with | Option.some zs => Option.some (LexLeanBoot.LexiconLse.Lse.LArg ((zs).1) ((zs).2)) | Option.none => Option.none) | LexLeanBoot.LexiconLse.Lse.LPi bs body => (match both (zonk (f) (metas) (bs)) (zonk (f) (metas) (body)) with | Option.some zs => Option.some (LexLeanBoot.LexiconLse.Lse.LPi ((zs).1) ((zs).2)) | Option.none => Option.none) | LexLeanBoot.LexiconLse.Lse.LLam bs body => (match both (zonk (f) (metas) (bs)) (zonk (f) (metas) (body)) with | Option.some zs => Option.some (LexLeanBoot.LexiconLse.Lse.LLam ((zs).1) ((zs).2)) | Option.none => Option.none) | LexLeanBoot.LexiconLse.Lse.LBinder m n t r => (match both (zonk (f) (metas) (t)) (zonk (f) (metas) (r)) with | Option.some zs => Option.some (LexLeanBoot.LexiconLse.Lse.LBinder (m) (n) ((zs).1) ((zs).2)) | Option.none => Option.none) | LexLeanBoot.LexiconLse.Lse.LLet n t v body => (match both (zonk (f) (metas) (t)) (zonk (f) (metas) (v)) with | Option.some zs => (match zonk (f) (metas) (body) with | Option.some zbody => Option.some (LexLeanBoot.LexiconLse.Lse.LLet (n) ((zs).1) ((zs).2) (zbody)) | Option.none => Option.none) | Option.none => Option.none) | LexLeanBoot.LexiconLse.Lse.LSortProp => Option.some (LexLeanBoot.LexiconLse.Lse.LSortProp) | LexLeanBoot.LexiconLse.Lse.LSortType u => Option.some (LexLeanBoot.LexiconLse.Lse.LSortType (u)) | LexLeanBoot.LexiconLse.Lse.LConst p e us => Option.some (LexLeanBoot.LexiconLse.Lse.LConst (p) (e) (us)) | LexLeanBoot.LexiconLse.Lse.LNat digits => Option.some (LexLeanBoot.LexiconLse.Lse.LNat (digits)) | LexLeanBoot.LexiconLse.Lse.LNil => Option.some (LexLeanBoot.LexiconLse.Lse.LNil))

@[expose] public def zonkSt (fuel : Fuel) (st : Ck) (expr : LexLeanBoot.LexiconLse.Lse) : Sr := (match zonk (fuel) ((st).metas) (expr) with | Option.some done => ({ out := done, ck := st } : Sr) | Option.none => ({ out := expr, ck := ckExhaust (st) } : Sr))

@[expose] public def unionOf (left : Option (List (ByteArray))) (right : Option (List (ByteArray))) : Option (List (ByteArray)) := (match left with | Option.none => Option.none | Option.some l => (match right with | Option.none => Option.none | Option.some r => Option.some ((LexLeanCollections.listFold ((fun (acc : List (ByteArray)) (item : ByteArray) => (item :: acc))) (r) (l) : List (ByteArray)))))

@[expose] public def boundIn (names : List (ByteArray)) (wanted : ByteArray) : Bool := (LexLeanCollections.listFold ((fun (found : Bool) (item : ByteArray) => (if found then true else (LexLeanRuntime.equal (item) (wanted) : Bool)))) (false) (names) : Bool)

mutual
@[expose] public def freeLocals : (fuel : Fuel) -> (expr : LexLeanBoot.LexiconLse.Lse) -> (bound : List (ByteArray)) -> Option (List (ByteArray))
  | Fuel.FZ, _expr, _bound => Option.none
  | Fuel.FS f, expr, bound => (match expr with | LexLeanBoot.LexiconLse.Lse.LLocal name => (if boundIn (bound) (name) then Option.some (([] : List (ByteArray))) else Option.some ((name :: ([] : List (ByteArray))))) | LexLeanBoot.LexiconLse.Lse.LApp g args => unionOf (freeLocals (f) (g) (bound)) (freeLocals (f) (args) (bound)) | LexLeanBoot.LexiconLse.Lse.LArg h t => unionOf (freeLocals (f) (h) (bound)) (freeLocals (f) (t) (bound)) | LexLeanBoot.LexiconLse.Lse.LPi bs body => freeBinders (f) (bs) (bound) (body) | LexLeanBoot.LexiconLse.Lse.LLam bs body => freeBinders (f) (bs) (bound) (body) | LexLeanBoot.LexiconLse.Lse.LLet n t v body => unionOf (unionOf (freeLocals (f) (t) (bound)) (freeLocals (f) (v) (bound))) (freeLocals (f) (body) ((n :: bound))) | LexLeanBoot.LexiconLse.Lse.LSortProp => Option.some (([] : List (ByteArray))) | LexLeanBoot.LexiconLse.Lse.LSortType _ => Option.some (([] : List (ByteArray))) | LexLeanBoot.LexiconLse.Lse.LConst _ _ _ => Option.some (([] : List (ByteArray))) | LexLeanBoot.LexiconLse.Lse.LNat _ => Option.some (([] : List (ByteArray))) | LexLeanBoot.LexiconLse.Lse.LNil => Option.some (([] : List (ByteArray))) | LexLeanBoot.LexiconLse.Lse.LBinder _ _ _ _ => Option.some (([] : List (ByteArray))))
termination_by structural fuel _ _ => fuel

@[expose] public def freeBinders : (fuel : Fuel) -> (chain : LexLeanBoot.LexiconLse.Lse) -> (bound : List (ByteArray)) -> (body : LexLeanBoot.LexiconLse.Lse) -> Option (List (ByteArray))
  | Fuel.FZ, _chain, _bound, _body => Option.none
  | Fuel.FS f, chain, bound, body => (match chain with | LexLeanBoot.LexiconLse.Lse.LBinder _ n t r => unionOf (freeLocals (f) (t) (bound)) (freeBinders (f) (r) ((n :: bound)) (body)) | LexLeanBoot.LexiconLse.Lse.LNil => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LSortProp => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LSortType _ => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LConst _ _ _ => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LLocal _ => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LApp _ _ => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LPi _ _ => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LLam _ _ => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LLet _ _ _ _ => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LNat _ => freeLocals (f) (body) (bound) | LexLeanBoot.LexiconLse.Lse.LArg _ _ => freeLocals (f) (body) (bound))
termination_by structural fuel _ _ _ => fuel
end

@[expose] public def flagOf (flagged : (Prod (Bool) (Ck))) : Bool := (flagged).1

@[expose] public def hasUnsolved (fuel : Fuel) (st : Ck) (expr : LexLeanBoot.LexiconLse.Lse) : (Prod (Bool) (Ck)) := (let zonked : Sr := zonkSt (fuel) (st) (expr); (match freeLocals (fuel) ((zonked).out) (([] : List (ByteArray))) with | Option.some names => ((LexLeanCollections.listFold ((fun (found : Bool) (name : ByteArray) => (if found then true else isMeta (name)))) (false) (names) : Bool), (zonked).ck) | Option.none => (true, ckExhaust ((zonked).ck))))

mutual
@[expose] public def substIn : (fuel : Fuel) -> (st : Ck) -> (expr : LexLeanBoot.LexiconLse.Lse) -> (name : ByteArray) -> (replacement : LexLeanBoot.LexiconLse.Lse) -> (avoid : List (ByteArray)) -> Sr
  | Fuel.FZ, st, expr, _name, _replacement, _avoid => ({ out := expr, ck := ckExhaust (st) } : Sr)
  | Fuel.FS f, st, expr, name, replacement, avoid => (match expr with | LexLeanBoot.LexiconLse.Lse.LLocal lname => (if (LexLeanRuntime.equal (lname) (name) : Bool) then ({ out := replacement, ck := st } : Sr) else ({ out := LexLeanBoot.LexiconLse.Lse.LLocal (lname), ck := st } : Sr)) | LexLeanBoot.LexiconLse.Lse.LApp g args => (let sg : Sr := substIn (f) (st) (g) (name) (replacement) (avoid); (let sa : Sr := substIn (f) ((sg).ck) (args) (name) (replacement) (avoid); ({ out := LexLeanBoot.LexiconLse.Lse.LApp ((sg).out) ((sa).out), ck := (sa).ck } : Sr))) | LexLeanBoot.LexiconLse.Lse.LArg h t => (let sh : Sr := substIn (f) (st) (h) (name) (replacement) (avoid); (let stl : Sr := substIn (f) ((sh).ck) (t) (name) (replacement) (avoid); ({ out := LexLeanBoot.LexiconLse.Lse.LArg ((sh).out) ((stl).out), ck := (stl).ck } : Sr))) | LexLeanBoot.LexiconLse.Lse.LPi bs body => (let sb : Sb := substChain (f) (st) (bs) (name) (replacement) (avoid) (([] : List ((Prod (ByteArray) (ByteArray))))) (false); (let sbody : Sr := substBody (f) (sb) (body) (name) (replacement) (avoid); ({ out := LexLeanBoot.LexiconLse.Lse.LPi ((sb).chain) ((sbody).out), ck := (sbody).ck } : Sr))) | LexLeanBoot.LexiconLse.Lse.LLam bs body => (let sb : Sb := substChain (f) (st) (bs) (name) (replacement) (avoid) (([] : List ((Prod (ByteArray) (ByteArray))))) (false); (let sbody : Sr := substBody (f) (sb) (body) (name) (replacement) (avoid); ({ out := LexLeanBoot.LexiconLse.Lse.LLam ((sb).chain) ((sbody).out), ck := (sbody).ck } : Sr))) | LexLeanBoot.LexiconLse.Lse.LLet bound t v body => (let stt : Sr := substIn (f) (st) (t) (name) (replacement) (avoid); (let sv : Sr := substIn (f) ((stt).ck) (v) (name) (replacement) (avoid); (if (LexLeanRuntime.equal (bound) (name) : Bool) then ({ out := LexLeanBoot.LexiconLse.Lse.LLet (bound) ((stt).out) ((sv).out) (body), ck := (sv).ck } : Sr) else (if boundIn (avoid) (bound) then (let named : (Prod (ByteArray) (Ck)) := freshLocal ((sv).ck) (bound); (let renamed : Sr := substIn (f) ((named).2) (body) (bound) (LexLeanBoot.LexiconLse.Lse.LLocal ((named).1)) (([] : List (ByteArray))); (let sbody : Sr := substIn (f) ((renamed).ck) ((renamed).out) (name) (replacement) (avoid); ({ out := LexLeanBoot.LexiconLse.Lse.LLet ((named).1) ((stt).out) ((sv).out) ((sbody).out), ck := (sbody).ck } : Sr)))) else (let sbody : Sr := substIn (f) ((sv).ck) (body) (name) (replacement) (avoid); ({ out := LexLeanBoot.LexiconLse.Lse.LLet (bound) ((stt).out) ((sv).out) ((sbody).out), ck := (sbody).ck } : Sr)))))) | LexLeanBoot.LexiconLse.Lse.LBinder m n t r => ({ out := LexLeanBoot.LexiconLse.Lse.LBinder (m) (n) (t) (r), ck := st } : Sr) | LexLeanBoot.LexiconLse.Lse.LSortProp => ({ out := LexLeanBoot.LexiconLse.Lse.LSortProp, ck := st } : Sr) | LexLeanBoot.LexiconLse.Lse.LSortType u => ({ out := LexLeanBoot.LexiconLse.Lse.LSortType (u), ck := st } : Sr) | LexLeanBoot.LexiconLse.Lse.LConst p e us => ({ out := LexLeanBoot.LexiconLse.Lse.LConst (p) (e) (us), ck := st } : Sr) | LexLeanBoot.LexiconLse.Lse.LNat digits => ({ out := LexLeanBoot.LexiconLse.Lse.LNat (digits), ck := st } : Sr) | LexLeanBoot.LexiconLse.Lse.LNil => ({ out := LexLeanBoot.LexiconLse.Lse.LNil, ck := st } : Sr))
termination_by structural fuel _ _ _ _ _ => fuel

