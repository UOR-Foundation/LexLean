@[expose] public def isUnary (head : ByteArray) : Bool := (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("group")) : Bool) then true else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("paren")) : Bool) then true else (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("bracket")) : Bool)))

@[expose] public def isBinary (head : ByteArray) : Bool := (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("sub")) : Bool) then true else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("sup")) : Bool) then true else (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("frac")) : Bool)))

@[expose] public def visitHead (st : Rv) (rest : List (RWork)) (head : ByteArray) (arguments : List (LexLeanBoot.LexiconLse.Node)) (fuel : Nat) : Rv := (let argc : Nat := (LexLeanRuntime.length (arguments) : Nat); (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("form")) : Bool) then visitForm (st) (rest) (arguments) (fuel) else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("self-form")) : Bool) then visitNamed (st) (rest) (arguments) (fuel) (LexLeanBoot.LexiconLse.lit ("a form ID")) (LexLeanBoot.LexiconLse.lit ("a self form is `(self-form form-id)`")) (0) else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("slot")) : Bool) then visitSlot (st) (rest) (arguments) (fuel) else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("space")) : Bool) then (if (Nat.beq (argc) (0)) then rvPush (st) (rest) (Render.RSpace) else rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("`(space)` takes no operand")))) else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("token")) : Bool) then visitNamed (st) (rest) (arguments) (fuel) (LexLeanBoot.LexiconLse.lit ("a renderer-token ID")) (LexLeanBoot.LexiconLse.lit ("a token is `(token renderer-token-id)`")) (1) else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("operator-name")) : Bool) then visitNamed (st) (rest) (arguments) (fuel) (LexLeanBoot.LexiconLse.lit ("an operator name")) (LexLeanBoot.LexiconLse.lit ("an operator name is `(operator-name identifier)`")) (2) else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("seq")) : Bool) then (if (Nat.beq (argc) (0)) then rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("`seq` has at least one item"))) else ({ work := pushVisitsR (arguments) ((RWork.RBuild (head) (argc) :: rest)), values := (st).values, error := Option.none } : Rv)) else (if isUnary (head) then (if (Nat.beq (argc) (1)) then ({ work := (RWork.RVisit (LexLeanBoot.LexiconLse.nodeAt (argu