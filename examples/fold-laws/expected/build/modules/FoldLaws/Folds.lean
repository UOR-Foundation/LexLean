@[expose] public def setDoubled (s : List (Nat)) : Nat := (LexLeanCollections.setFold ((fun (acc : Nat) (v : Nat) => (acc + (LexLeanRuntime.multiply (2) (v) : Nat)))) (0) (s) : Nat)

@[expose] public def entryTotal (m : List (Prod (Nat) (Nat))) : Nat := (LexLeanCollections.mapFold ((fun (acc : Nat) (k : Nat) (v : Nat) => (acc + (k + v)))) (0) (m) : Nat)

@[expose] public def keyTotal (m : List (Prod (Nat) (Nat))) : Nat := (LexLeanCollections.mapFold ((fun (acc : Nat) (k : Nat) (_v : Nat) => (acc + k))) (0) (m) : Nat)

@[expose] public def valueTotal (m : List (Prod (Nat) (Nat))) : Nat := (LexLeanCollections.mapFold ((fun (acc : Nat) (_k : Nat) (v : Nat) => (acc + v))) (0) (m) : Nat)

