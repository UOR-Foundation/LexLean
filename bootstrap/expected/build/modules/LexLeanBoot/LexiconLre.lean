@[expose] public def rvVisit (st : Rv) (rest : List (RWork)) (node : LexLeanBoot.LexiconLse.Node) (fuel : Nat) : Rv := (match node with | LexLeanBoot.LexiconLse.Node.NList chain => (match LexLeanBoot.LexiconLse.itemsOf (chain) (fuel) with | List.nil => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("expected an LRE form"))) | List.cons headNode arguments => (match headNode with | LexLeanBoot.LexiconLse.Node.NAtom head => visitHead (st) (rest) (head) (arguments) (fuel) | LexLeanBoot.LexiconLse.Node.NList _ => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("expected an LRE form"))) | LexLeanBoot.LexiconLse.Node.NNil => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("expected an LRE form"))) | LexLeanBoot.LexiconLse.Node.NItem _ _ => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("expected an LRE form"))))) | LexLeanBoot.LexiconLse.Node.NAtom _ => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.cat (LexLeanBoot.LexiconLse.lit ("expected `(`, found ")) (LexLeanBoot.LexiconLse.describe (node)))) | LexLeanBoot.LexiconLse.Node.NNil => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.cat (LexLeanBoot.LexiconLse.lit ("expected `(`, found ")) (LexLeanBoot.LexiconLse.describe (node)))) | LexLeanBoot.LexiconLse.Node.NItem _ _ => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.cat (LexLeanBoot.LexiconLse.lit ("expected `(`, found ")) (LexLeanBoot.LexiconLse.describe (node)))))

@[expose] public def wrapOne (head : ByteArray) (inner : Render) : Render := (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("group")) : Bool) then Render.RGroup (inner) else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("paren")) : Bool) then Render.RParen (inner) else Render.RBracket (inner)))

@[expose] public def wrapTwo (head : ByteArray) (left : Render) (right : Render) : Render := (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("sub")) : Bool) then Render.RSub (left) (right) else (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("sup")) : Bool) then Render.RSup (left) (right) else Render.RFrac (left) (right)))

@[expose] public def rvBuild (st : Rv) (rest : List (RWork)) (head : ByteArray) (count : Nat) : Rv := (let taken : (Prod (List (Render)) (List (Render))) := takeRenders ((st).values) (count); (let parts : List (Render) := (taken).1; (if (LexLeanRuntime.equal (head) (LexLeanBoot.LexiconLse.lit ("seq")) : Bool) then rvPush (({ work := rest, values := (taken).2, error := Option.none } : Rv)) (rest) (Render.RSeq (renderChain (parts))) else (if isUnary (head) then (match parts with | List.nil => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("missing operand"))) | List.cons inner _ => rvPush (({ work := rest, values := (taken).2, error := Option.none } : Rv)) (rest) (wrapOne (head) (inner))) else (match parts with | List.nil => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("missing operand"))) | List.cons left more => (match more with | List.nil => rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("missing operand"))) | List.cons right _ => rvPush (({ work := rest, values := (taken).2, error := Option.none } : Rv)) (rest) (wrapTwo (head) (left) (right))))))))

@[expose] public def rvStep (fuel : Nat) (st : Rv) : Option (Rv) := (match (st).error with | Option.some _ => Option.none | Option.none => (match (st).work with | List.nil => Option.none | List.cons item rest => (match item with | RWork.RVisit node => Option.some (rvVisit (st) (rest) (node) (fuel)) | RWork.RBuild head count => Option.some (rvBuild (st) (rest) (head) (count)))))

