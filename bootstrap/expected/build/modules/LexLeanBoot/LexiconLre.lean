@[expose] public def scanTokenId (subject : ByteArray) (n : Nat) (position : Nat) : Option (Nat) := (if (Nat.blt (position) (n)) then (let value : Nat := LexLeanBoot.LexiconLse.byteNum (subject) (position); (if (if LexLeanBoot.LexiconLse.isLowerNum (value) then true else (if LexLeanBoot.LexiconLse.isDigitNum (value) then true else (Nat.beq (value) (45)))) then Option.some ((position + 1)) else Option.none)) else Option.none)

