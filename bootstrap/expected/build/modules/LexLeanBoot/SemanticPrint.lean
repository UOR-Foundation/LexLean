@[expose] public def objectAt (chain : LexLeanStd.Json.Json) (pos : Pos) (docs : List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc)))) : LexLeanBoot.SurfaceDoc.Doc := (match pos with | Pos.PTerm => (if termReadableAt (chain) then termDoc (chain) ((match kindOf (chain) with | Option.some kind => kind | Option.none => lit (""))) (docs) else taggedDoc (chain) (docs)) | Pos.PType => (if typeReadableAt (chain) then typeDoc (chain) ((match kindOf (chain) with | Option.some kind => kind | Option.none => lit (""))) (docs) else taggedDoc (chain) (docs)) | Pos.PMember => (match memberText (LexLeanStd.Json.Json.JObj (chain)) with | Option.some text => tx (text) | Option.none => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JObj (chain))) | Pos.PParam => (if paramOk (LexLeanStd.Json.Json.JObj (chain)) then seq ((tx (cat (strAt (chain) (lit ("name"))) (lit (" : "))) :: (docOf (docs) (lit ("type")) :: ([] : List (LexLeanBoot.SurfaceDoc.Doc))))) else taggedDoc (chain) (docs)) | Pos.PNode _ => taggedDoc (chain) (docs) | Pos.PAssign => seq ((tx (cat (strAt (chain) (lit ("field"))) (lit (" := "))) :: (docOf (docs) (lit ("value")) :: ([] : List (LexLeanBoot.SurfaceDoc.Doc))))) | Pos.PBranch => branchDoc (chain) (docs) | Pos.PAny => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JObj (chain)) | Pos.PArgs => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JObj (chain)) | Pos.PTypeArgs => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JObj (chain)) | Pos.PFunParams => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JObj (chain)) | Pos.PFnTypes => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JObj (chain)) | Pos.PNamedArgs => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JObj (chain)) | Pos.PAssigns => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JObj (chain)) | Pos.PBranches => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JObj (chain)))

@[expose] public def noKids (kids : Kids) : Bool := (match kids with | Kids.KNone => true | Kids.KSchema _ => false | Kids.KTerm _ => false | Kids.KType => false | Kids.KParam => false | Kids.KAssign => false | Kids.KBranch => false)

mutual
@[expose] public def docAt : (schema : LexLeanStd.Json.Json) -> (value : LexLeanStd.Json.Json) -> (pos : Pos) -> LexLeanBoot.SurfaceDoc.Doc
  | schema, LexLeanStd.Json.Json.JObj members, pos => objectAt (members) (pos) (docMembersAt (schema) (members) (kidsFor (schema) (members) (pos)))
  | schema, LexLeanStd.Json.Json.JArr items, pos => arrayDoc (pos) (docItemsAt (schema) (items) (itemPosFor (schema) (pos)))
  | _schema, LexLeanStd.Json.Json.JBool flag, _pos => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JBool (flag))
  | _schema, LexLeanStd.Json.Json.JInt negative magnitude, _pos => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JInt (negative) (magnitude))
  | _schema, LexLeanStd.Json.Json.JStr text, _pos => LexLeanBoot.SurfaceGeneric.docValue (LexLeanStd.Json.Json.JStr (text))
  | _schema, LexLeanStd.Json.Json.JNil, _pos => LexLeanBoot.SurfaceDoc.Doc.DNil
  | _schema, LexLeanStd.Json.Json.JItem _ _, _pos => LexLeanBoot.SurfaceDoc.Doc.DNil
  | _schema, LexLeanStd.Json.Json.JMember _ _ _, _pos => LexLeanBoot.SurfaceDoc.Doc.DNil
termination_by structural _ value _ => value

@[expose] public def docItemsAt : (schema : LexLeanStd.Json.Json) -> (items : LexLeanStd.Json.Json) -> (pos : Pos) -> List (LexLeanBoot.SurfaceDoc.Doc)
  | schema, LexLeanStd.Json.Json.JItem element rest, pos => (docAt (schema) (element) (pos) :: docItemsAt (schema) (rest) (pos))
  | _schema, LexLeanStd.Json.Json.JBool _, _pos => ([] : List (LexLeanBoot.SurfaceDoc.Doc))
  | _schema, LexLeanStd.Json.Json.JInt _ _, _pos => ([] : List (LexLeanBoot.SurfaceDoc.Doc))
  | _schema, LexLeanStd.Json.Json.JStr _, _pos => ([] : List (LexLeanBoot.SurfaceDoc.Doc))
  | _schema, LexLeanStd.Json.Json.JArr _, _pos => ([] : List (LexLeanBoot.SurfaceDoc.Doc))
  | _schema, LexLeanStd.Json.Json.JObj _, _pos => ([] : List (LexLeanBoot.SurfaceDoc.Doc))
  | _schema, LexLeanStd.Json.Json.JNil, _pos => ([] : List (LexLeanBoot.SurfaceDoc.Doc))
  | _schema, LexLeanStd.Json.Json.JMember _ _ _, _pos => ([] : List (LexLeanBoot.SurfaceDoc.Doc))
termination_by structural _ items _ => items

@[expose] public def docMembersAt : (schema : LexLeanStd.Json.Json) -> (members : LexLeanStd.Json.Json) -> (kids : Kids) -> List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc)))
  | schema, LexLeanStd.Json.Json.JMember key inner rest, kids => (if noKids (kids) then ([] : List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc)))) else ((key, docAt (schema) (inner) (kidPos (schema) (kids) (key))) :: docMembersAt (schema) (rest) (kids)))
  | _schema, LexLeanStd.Json.Json.JBool _, _kids => ([] : List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc))))
  | _schema, LexLeanStd.Json.Json.JInt _ _, _kids => ([] : List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc))))
  | _schema, LexLeanStd.Json.Json.JStr _, _kids => ([] : List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc))))
  | _schema, LexLeanStd.Json.Json.JArr _, _kids => ([] : List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc))))
  | _schema, LexLeanStd.Json.Json.JObj _, _kids => ([] : List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc))))
  | _schema, LexLeanStd.Json.Json.JNil, _kids => ([] : List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc))))
  | _schema, LexLeanStd.Json.Json.JItem _ _, _kids => ([] : List ((Prod (ByteArray) (LexLeanBoot.SurfaceDoc.Doc))))
termination_by structural _ members _ => members
end

@[expose] public def render (node : LexLeanBoot.SurfaceDoc.Doc) : ByteArray := LexLeanBoot.SurfaceDoc.renderDoc (node) (100) (LexLeanBoot.SurfaceGeneric.docNodes (node))

@[expose] public def positionOf (schema : LexLeanStd.Json.Json) (position : Nat) : Pos := (if (Nat.beq (position) (0)) then (match getIn (schema) (lit ("properties")) with | Option.some properties => (match getIn (properties) (lit ("declarations")) with | Option.some declarations => itemsOf (schema) (declarations) | Option.none => Pos.PAny) | Option.none => Pos.PAny) else (if (Nat.beq (position) (1)) then Pos.PTerm else (if (Nat.beq (position) (2)) then Pos.PType else (match defNamed (schema) (lit ("proof")) with | Option.some proof => Pos.PNode (proof) | Option.none => Pos.PAny))))

@[expose] public def printAt (schema : LexLeanStd.Json.Json) (value : LexLeanStd.Json.Json) (position : Nat) : ByteArray := render (docAt (schema) (value) (positionOf (schema) (position)))

@[expose] public def refusal (message : ByteArray) : Except (LexLeanBoot.SurfaceLex.Failure) (ByteArray) := Except.error (({ offset := 0, message := message } : LexLeanBoot.SurfaceLex.Failure))

@[expose] public def printSemanticModule (schema : LexLeanStd.Json.Json) (given : LexLeanStd.Json.Json) : Except (LexLeanBoot.SurfaceLex.Failure) (ByteArray) := (match asObj (given) with | Option.some chain => (match arrOf (memberIn (chain) (lit ("declarations"))) with | Option.some declarations => (if both ((Nat.beq (countOf (chain)) (2))) ((match strOf (memberIn (chain) (lit ("spec"))) with | Option.some _ => true | Option.none => false)) then (let place : Pos := positionOf (schema) (0); Except.ok (((LexLeanCollections.listFold ((fun (state : (Prod (Bool) (ByteArray))) (declaration : LexLeanStd.Json.Json) => (false, cat ((if (state).1 then (state).2 else cat ((state).2) (lit ("\n")))) (cat (render (docAt (schema) (declaration) (place))) (lit ("\n")))))) ((true, lit (""))) (itemsOfChain (declarations)) : (Prod (Bool) (ByteArray)))).2)) else refusal (lit ("a module has exactly a `spec` and its `declarations`"))) | Option.none => refusal (lit ("a module has a `declarations` array"))) | Option.none => refusal (lit ("a module is an object")))

end LexLeanBoot.SemanticPrint
