@[expose] public def flatId (ident : LexLeanBoot.RustValidate.Id) (state : Flat) : Flat := (match lookupBound ((state).names) (ident) with | Option.some number => push (push (state) ((100 + idTag (ident))) (number)) (99) (0) | Option.none => push (state) ((60 + idTag (ident))) (idNum (ident)))

@[expose] public def flatPat : (pat : LexLeanBoot.RustAst.Pat) -> (state : Flat) -> Flat
  | LexLeanBoot.RustAst.Pat.PLeaf leaf, state => push (state) (80) (leafPatCode (leaf))
  | LexLeanBoot.RustAst.Pat.PBind ident, state => ({ toks := (((90 + idTag (ident)), 0) :: (state).toks), blobs := (state).blobs, names := ((ident, (state).next) :: (state).names), next := ((state).next + 1) } : Flat)
