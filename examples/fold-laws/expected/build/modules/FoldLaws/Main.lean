@[expose] public def statistics (xs : List (Nat)) : (Prod (Nat) (Nat)) := (LexLeanCollections.listFold ((fun (p : (Prod (Nat) (Nat))) (v : Nat) => (((p).1 + v), ((p).2 + 1)))) ((0, 0)) (xs) : (Prod (Nat) (Nat)))

public theorem statistics_one_pass (xs : List (Nat)) : (statistics (xs) = (FoldLaws.Folds.total (xs), FoldLaws.Folds.count (xs))) := by
  exact @LexLeanLaws.listFold_pair (Nat) (Nat) (Nat) ((fun (acc : Nat) (v : Nat) => (acc + v))) ((fun (acc : Nat) (_v : Nat) => (acc + 1))) (0) (0) (xs)

