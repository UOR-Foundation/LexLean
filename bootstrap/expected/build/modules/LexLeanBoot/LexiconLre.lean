@[expose] public def scanOperatorName (subject : ByteArray) (n : Nat) (position : Nat) : Option (Nat) := (if (Nat.blt (position) (n)) then (let value : Nat := LexLeanBoot.LexiconLse.byteNum (subject) (position); (if (if LexLeanBoot.LexiconLse.isAlnumNum (value) then true else (Nat.beq (value) (95))) then Option.some ((position + 1)) else Option.none)) else Option.none)

