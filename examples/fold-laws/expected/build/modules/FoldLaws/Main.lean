public theorem parity_fused (xs : List (Nat)) : ((LexLeanRuntime.remainder (FoldLaws.Folds.total (xs)) (2) (0) : Nat) = (LexLeanCollections.listFold ((fun (acc : Nat) (v : Nat) => (LexLeanRuntime.remainder ((acc + v)) (2) (0) : Nat))) ((LexLeanRuntime.remainder (0) (2) (0) : Nat)) (xs) : Nat)) := by
  exact @LexLeanLaws.listFold_fusion (Nat) (Nat) (Nat) ((fun (acc : Nat) (v : Nat) => (acc + v))) ((fun (acc : Nat) (v : Nat) => (LexLeanRuntime.remainder ((acc + v)) (2) (0) : Nat))) ((fun (n : Nat) => (LexLeanRuntime.remainder (n) (2) (0) : Nat))) (0) (xs) parity_step

public theorem parity_of_total (xs : List (Nat)) : ((LexLeanRuntime.remainder (FoldLaws.Folds.total (xs)) (2) (0) : Nat) = parity (xs)) := by
  exact parity_fused (xs)

