@[expose] public def pdfRecipeId (texDigest : ByteArray) (programDigest : ByteArray) (versionDigest : ByteArray) (compileArgv : ByteArray) (resources : ByteArray) : ByteArray := framedHash (lit ("lexlean-pdf-recipe-v1")) (cat (cat (cat (cat (frame (lit ("tex")) (texDigest)) (frame (lit ("program")) (programDigest))) (frame (lit ("version-output")) (versionDigest))) (frame (lit ("argv")) (compileArgv))) (frame (lit ("resources")) (resources)))

end LexLeanBoot.ContentId
