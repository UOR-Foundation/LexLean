#!/bin/sh
# Passes every invocation to the pinned lake except `lake env lean` on a
# preservation certificate, whose program literal first has every natural
# addition turned into a subtraction; the proof, derived from the source,
# no longer holds, and verification refuses the certificate (SPEC.md 17.17).
real="$(dirname "$(readlink -f "$(dirname "$0")/lean")")/lake"
if [ "$1" = "env" ] && [ "$2" = "lean" ]; then
  for source; do :; done
  case "$source" in
    */preserve-src/LexLeanPreserve/C*.lean)
      sed -i 's/\.prim \.natAdd/.prim .natSub/g' "$source"
      ;;
  esac
fi
exec "$real" "$@"
