#!/bin/sh
# Passes every invocation to the pinned lake except `lake env lean` on a
# certificate E, whose statement first claims the root's Rust function with
# the other result shape (`R<T>` for a plain function and a plain result for
# a fallible one): certificates A and B still hold, but no composition of
# them proves the restatement, and verification refuses it (SPEC.md 17.17).
# The certificate is kernel-term data rendered by the core backend, so the
# swap is made in the data the Lean text carries: the constant node of the
# fallibility flag, {"k":"c","n":"Bool.true","u":[]}, which the statement
# and the proof share.
real="$(dirname "$(readlink -f "$(dirname "$0")/lean")")/lake"
if [ "$1" = "env" ] && [ "$2" = "lean" ]; then
  for source; do :; done
  case "$source" in
    */preserve-src/LexLeanPreserve/C*/R*/Compose/Rust*.lean)
      sed -e 's/\\"n\\":\\"Bool\.true\\"/\\"n\\":\\"Bool.swapped\\"/g' \
        -e 's/\\"n\\":\\"Bool\.false\\"/\\"n\\":\\"Bool.true\\"/g' \
        -e 's/\\"n\\":\\"Bool\.swapped\\"/\\"n\\":\\"Bool.false\\"/g' "$source" > "$source.tmp" && mv "$source.tmp" "$source"
      ;;
  esac
fi
exec "$real" "$@"
