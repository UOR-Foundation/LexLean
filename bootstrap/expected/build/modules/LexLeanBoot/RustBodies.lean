  | LexLeanBoot.RustAst.Expr.EMatch scrutinee arms _, state => flatE (arms) (flatE (scrutinee) (push (state) (9) (0)))
  | LexLeanBoot.RustAst.Expr.EBlockE block, state => flatE (block) (state)
  | LexLeanBoot.RustAst.Expr.EProbe kind ident _, state => flatId (ident) (push (state) (10) (probeCode2 (kind)))
  | LexLeanBoot.RustAst.Expr.EBlock lets tail, state => flatE (tail) (push (flatE (lets) (push (state) (11) (0))) (12) (0))
  | LexLeanBoot.RustAst.Expr.ENil, state => push (state) (13) (0)
  | LexLeanBoot.RustAst.Expr.ECons head tail, state => flatE (tail) (flatE (head) (push (state) (14) (0)))
