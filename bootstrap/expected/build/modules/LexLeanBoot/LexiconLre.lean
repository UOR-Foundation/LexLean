@[expose] public def isFormId (text : ByteArray) : Bool := isTokenId (text)

@[expose] public def rvFail (st : Rv) (failure : LexLeanBoot.LexiconLse.Failure) : Rv := ({ work := (st).work, values := (st).values, error := Option.some (failure) } : Rv)

@[expose] public def rvPush (st : Rv) (rest : List (RWork)) (value : Render) : Rv := ({ work := rest, values := (value :: (st).values), error := Option.none } : Rv)

@[expose] public def pushVisitsR (items : List (LexLeanBoot.LexiconLse.Node)) (work : List (RWork)) : List (RWork) := (LexLeanCollections.listFold ((fun (acc : List (RWork)) (item : LexLeanBoot.LexiconLse.Node) => (RWork.RVisit (item) :: acc))) (work) (LexLeanStd.Order.reverseList (LexLeanBoot.LexiconLse.Node) (items)) : List (RWork))

@[expose] public def takeRenders (values : List (Render)) (count : Nat) : (Prod (List (Render)) (List (Render))) := ((LexLeanCollections.iterateUntil ((fun (state : (Prod (List (Render)) (List (Render)))) => (match (state).2 with | List.nil => Option.none | List.cons top rest => Option.some (((top :: (state).1), rest))))) (count) ((([] : List (Render)), values)) : (Prod ((Prod (List (Render)) (List (Render)))) (Bool)))).1

@[expose] public def renderChain (items : List (Render)) : Render := (LexLeanCollections.listFold ((fun (chain : Render) (item : Render) => Render.RItem (item) (chain))) (Render.RNil) (LexLeanStd.Order.reverseList (Render) (items)) : Render)

@[expose] public def visitForm (st : Rv) (rest : List (RWork)) (arguments : List (LexLeanBoot.LexiconLse.Node)) (fuel : Nat) : Rv := (if (Nat.beq ((LexLeanRuntime.length (arguments) : Nat)) (2)) then (match LexLeanBoot.LexiconLse.atomOf (LexLeanBoot.LexiconLse.nodeAt (arguments) (0)) (LexLeanBoot.LexiconLse.lit ("a qualified ID")) (fuel) with | Except.ok spelled => (match LexLeanBoot.LexiconLse.qualifiedId (spelled) with | Except.ok parts => (match LexLeanBoot.LexiconLse.atomOf (LexLeanBoot.LexiconLse.nodeAt (arguments) (1)) (LexLeanBoot.LexiconLse.lit ("a form ID")) (fuel) with | Except.ok form => (if isFormId (form) then rvPush (st) (rest) (Render.RForm ((parts).1) ((parts).2) (form)) else rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.cat (LexLeanBoot.LexiconLse.quoted (form)) (LexLeanBoot.LexiconLse.lit (" is not a form ID"))))) | Except.error failure => rvFail (st) (failure)) | Except.error failure => rvFail (st) (failure)) | Except.error failure => rvFail (st) (failure)) else rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.lit ("a form reference is `(form qualified-id form-id)`"))))

@[expose] public def visitNamed (st : Rv) (rest : List (RWork)) (arguments : List (LexLeanBoot.LexiconLse.Node)) (fuel : Nat) (what : ByteArray) (shape : ByteArray) (kind : Nat) : Rv := (if (Nat.beq ((LexLeanRuntime.length (arguments) : Nat)) (1)) then (match LexLeanBoot.LexiconLse.atomOf (LexLeanBoot.LexiconLse.nodeAt (arguments) (0)) (what) (fuel) with | Except.ok text => (if (Nat.beq (kind) (0)) then (if isFormId (text) then rvPush (st) (rest) (Render.RSelfForm (text)) else rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.cat (LexLeanBoot.LexiconLse.quoted (text)) (LexLeanBoot.LexiconLse.lit (" is not a form ID"))))) else (if (Nat.beq (kind) (1)) then (if isTokenId (text) then rvPush (st) (rest) (Render.RToken (text)) else rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.cat (LexLeanBoot.LexiconLse.quoted (text)) (LexLeanBoot.LexiconLse.lit (" is not a renderer-token ID"))))) else (if isOperatorName (text) then rvPush (st) (rest) (Render.ROperatorName (text)) else rvFail (st) (LexLeanBoot.LexiconLse.failed (LexLeanBoot.LexiconLse.cat (LexLeanBoot.LexiconLse.quoted (text)) (LexLeanBoot.LexiconLse.lit (" is not an operator name"))))))) | Except.error failure => rvFail (st) (failure)) else rvFail (st) (LexLeanBoot.LexiconLse.failed (shape)))

