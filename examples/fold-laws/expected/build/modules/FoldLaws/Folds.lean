@[expose] public def total (xs : List (Nat)) : Nat := (LexLeanCollections.listFold ((fun (acc : Nat) (v : Nat) => (acc + v))) (0) (xs) : Nat)

@[expose] public def count (xs : List (Nat)) : Nat := (LexLeanCollections.listFold ((fun (acc : Nat) (_v : Nat) => (acc + 1))) (0) (xs) : Nat)

@[expose] public def doubledTotal (xs : List (Nat)) : Nat := (LexLeanCollections.listFold ((fun (acc : Nat) (v : Nat) => ((acc + v) + v))) (0) (xs) : Nat)

@[expose] public def weighted (xs : List (Nat)) : Nat := (LexLeanCollections.listFold ((fun (acc : Nat) (v : Nat) => (acc + ((LexLeanRuntime.multiply (3) (v) : Nat) + 1)))) (0) (xs) : Nat)

