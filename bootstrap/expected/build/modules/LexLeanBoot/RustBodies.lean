  | List.nil, right => (match right with | List.nil => true | List.cons _ _ => false)
  | List.cons x xs, right => (match right with | List.nil => false | List.cons y ys => (if ((Nat.beq ((x).1) ((y).1)) && (Nat.beq ((x).2) ((y).2))) then tokensEq (xs) (ys) else false))

@[expose] public def blobsEq : (left : List (ByteArray)) -> (right : List (ByteArray)) -> Bool
  | List.nil, right => (match right with | List.nil => true | List.cons _ _ => false)
  | List.cons x xs, right => (match right with | List.nil => false | List.cons y ys => (if (LexLeanRuntime.equal (x) (y) : Bool) then blobsEq (xs) (ys) else false))

@[expose] public def emptyFlat (_seed : Nat) : Flat := ({ toks := ([] : List ((Prod (Nat) (Nat)))), blobs := ([] : List (ByteArray)), names := ([] : List ((Prod (LexLeanBoot.RustValidate.Id) (Nat)))), next := 0 } : Flat)

@[expose] public def sameCode (left : LexLeanBoot.RustAst.Expr) (right : LexLeanBoot.RustAst.Expr) : Bool := (let one : Flat := flatE (left) (emptyFlat (0)); (let two : Flat := flatE (right) (emptyFlat (0)); (if tokensEq ((one).toks) ((two).toks) then blobsEq ((one).blobs) ((two).blobs) else false)))

